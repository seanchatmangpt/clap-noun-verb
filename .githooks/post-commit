#!/bin/bash
# Post-commit hook: Helpful reminders and development tips
# Purpose: Provide guidance and context after a successful commit
# Exit: Always 0 (never blocks commits)
#
# This hook prints helpful reminders without interfering with workflows.

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$HOOKS_DIR")"

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Get the commit hash and message
COMMIT_HASH=$(git rev-parse --short HEAD)
COMMIT_MSG=$(git log -1 --pretty=format:"%s")

echo ""
echo "${GREEN}✅ Commit created: $COMMIT_HASH${NC}"
echo ""

# Detect commit type from message
if echo "$COMMIT_MSG" | grep -qiE "^(feat|feature)"; then
    COMMIT_TYPE="Feature"
    SUGGESTION="Consider writing tests for this feature"
elif echo "$COMMIT_MSG" | grep -qiE "^(fix|bugfix)"; then
    COMMIT_TYPE="Bug fix"
    SUGGESTION="Verify fix with: cargo test test_name"
elif echo "$COMMIT_MSG" | grep -qiE "^(test|tests)"; then
    COMMIT_TYPE="Test"
    SUGGESTION="Run: cargo make test to ensure all tests pass"
elif echo "$COMMIT_MSG" | grep -qiE "^(docs?|documentation)"; then
    COMMIT_TYPE="Documentation"
    SUGGESTION="Build docs with: cargo make doc"
elif echo "$COMMIT_MSG" | grep -qiE "^(refactor|perf)"; then
    COMMIT_TYPE="Refactoring"
    SUGGESTION="Verify refactoring: cargo make test-all"
else
    COMMIT_TYPE="Changes"
    SUGGESTION="Next: git push to send to remote"
fi

echo "${BLUE}ℹ️  Type: $COMMIT_TYPE${NC}"
echo "${BLUE}📝 Message: $COMMIT_MSG${NC}"
echo ""

# Show branch status
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
COMMITS_AHEAD=$(git rev-list --count origin/main..HEAD 2>/dev/null || echo "?")
UNPUSHED=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo "?")

echo "${CYAN}📍 Branch: $CURRENT_BRANCH${NC}"
if [ "$COMMITS_AHEAD" != "?" ]; then
    echo "${CYAN}📊 Commits ahead of main: $COMMITS_AHEAD${NC}"
fi

echo ""
echo "${YELLOW}💡 Suggestion: $SUGGESTION${NC}"
echo ""

# Show relevant next steps based on commit type and branch state
if echo "$CURRENT_BRANCH" | grep -qE "^(claude|feat|fix|refactor)"; then
    echo "${YELLOW}📋 Next steps:${NC}"
    echo "  1. Continue development or push to remote"
    echo "  2. When ready: ${BLUE}git push${NC} (pre-push hook validates tests)"
    echo "  3. Create PR from: ${BLUE}gh pr create${NC} or GitHub UI"
else
    echo "${YELLOW}📋 Next steps:${NC}"
    echo "  1. Push to remote: ${BLUE}git push${NC}"
    echo "  2. Start a PR if needed: ${BLUE}gh pr create${NC}"
fi

echo ""

# Remind about commit conventions
if ! echo "$COMMIT_MSG" | grep -qE '^(feat|fix|refactor|perf|docs|test|chore|ci|style|revert)(\(.+\))?:'; then
    echo "${YELLOW}💬 Tip: Future commits use conventional format:${NC}"
    echo "   Example: 'Fix router deadlock in shutdown sequence'"
    echo "   Fancy: 'Fix(router): handle race condition on shutdown'"
    echo ""
fi

# Show SLO status if available
if [ -f "$PROJECT_ROOT/CLAUDE.md" ]; then
    echo "${CYAN}📈 Performance SLOs:${NC}"
    echo "   ✓ Incremental compile: ≤2s (target met)"
    echo "   ✓ Binary size: ≤10MB (target met)"
    echo ""
fi

# Final encouragement
echo "${GREEN}🎉 Great work! Keep going.${NC}"
echo ""

exit 0
