#!/bin/bash
# Pre-commit hook: Fast quality gates (fail fast on formatting/clippy)
# Purpose: Catch common issues before commit
# Strategy: Run ONLY fast checks that take <2s total
# Exit: Non-zero to block commit, zero to allow
#
# This hook prioritizes speed and clear error messages.
# Heavy tests (full test suite) are deferred to pre-push hook.

set -e

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$HOOKS_DIR")"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Track failures
FAILED=0

echo ""
echo "${BLUE}════════════════════════════════════════════════════════════════${NC}"
echo "${BLUE}  📋 PRE-COMMIT HOOK: Fast Quality Gates${NC}"
echo "${BLUE}════════════════════════════════════════════════════════════════${NC}"

# Check 1: Code formatting (rustfmt) - FASTEST (~500ms)
echo ""
echo "${BLUE}🔍 Check 1/5: Code formatting (rustfmt)${NC}"
if cargo fmt -- --check >/dev/null 2>&1; then
    echo -e "${GREEN}✅ PASS: Formatting check${NC}"
else
    echo -e "${RED}❌ FAILED: Code formatting issues found${NC}"
    echo "   Fix with: ${BLUE}cargo make format${NC}"
    FAILED=1
fi

# Check 2: Clippy linting - MEDIUM SPEED (~1s)
echo ""
echo "${BLUE}🔍 Check 2/5: Linting (clippy)${NC}"
if cargo clippy --quiet -- -D warnings >/dev/null 2>&1; then
    echo -e "${GREEN}✅ PASS: Clippy check${NC}"
else
    echo -e "${RED}❌ FAILED: Clippy linting issues${NC}"
    echo "   Fix with: ${BLUE}cargo make clippy${NC}"
    FAILED=1
fi

# Check 3: License and security checks (cargo-deny) - FAST (~100ms)
echo ""
echo "${BLUE}🔍 Check 3/5: License/security (cargo-deny)${NC}"
if [ -f "$PROJECT_ROOT/deny.toml" ]; then
    if command -v cargo-deny &> /dev/null; then
        if cargo deny check licenses advisories bans --log-level off >/dev/null 2>&1; then
            echo -e "${GREEN}✅ PASS: Dependency checks${NC}"
        else
            echo -e "${RED}❌ FAILED: Dependency check issues${NC}"
            echo "   Review with: ${BLUE}cargo deny check${NC}"
            FAILED=1
        fi
    else
        echo -e "${YELLOW}⚠️  SKIP: cargo-deny not installed (optional)${NC}"
        echo "   Install with: ${BLUE}cargo install cargo-deny${NC}"
    fi
else
    echo -e "${YELLOW}⚠️  SKIP: No deny.toml configuration${NC}"
fi

# Check 4: Compilation check - MEDIUM SPEED (~800ms incremental)
echo ""
echo "${BLUE}🔍 Check 4/5: Compilation check${NC}"
if cargo check --quiet >/dev/null 2>&1; then
    echo -e "${GREEN}✅ PASS: Compilation check${NC}"
else
    echo -e "${RED}❌ FAILED: Code does not compile${NC}"
    echo "   Fix compilation errors above"
    FAILED=1
fi

# Check 5: Code-as-Projection Policy (existing custom checks)
echo ""
echo "${BLUE}🔍 Check 5/5: Projection policy validation${NC}"
PROJECTION_FAILED=0

# Check 5a: No hand-edit markers in generated code
if git diff --cached --name-only 2>/dev/null | grep -E '\.rs$' | \
   xargs grep -l "@generated" 2>/dev/null | while read f; do
    if git diff --cached "$f" 2>/dev/null | grep -q "^+.*TODO.*generated\|^+.*FIXME.*generated"; then
        echo -e "${RED}  ✗ Found hand-edit in $f${NC}"
        PROJECTION_FAILED=1
    fi
done; then
    :
fi

# Check 5b: Verify projection integrity for critical files
CRITICAL_FILES=(
  "src/autonomic/schema.rs"
  "src/kernel/session.rs"
  "src/autonomic/graph.rs"
)

for file in "${CRITICAL_FILES[@]}"; do
    if [ -f "$PROJECT_ROOT/$file" ] && git diff --cached --name-only 2>/dev/null | grep -q "^$file$"; then
        if ! git diff --cached "$file" 2>/dev/null | grep -q "^+\s*\/\/\s*@projection-of"; then
            echo -e "${YELLOW}  ⚠ Modifying $file - ensure changes reflect ontology updates${NC}"
        fi
    fi
done

if [ $PROJECTION_FAILED -eq 0 ]; then
    echo -e "${GREEN}✅ PASS: Projection policy checks${NC}"
else
    echo -e "${RED}❌ FAILED: Projection policy violations${NC}"
    echo "   Code-as-Projection Policy:"
    echo "   - Edit the ontology (Σ), not the generated code"
    echo "   - Use 'cargo run --bin ggen regenerate' to update generated code"
    FAILED=1
fi

# Summary
echo ""
echo "${BLUE}════════════════════════════════════════════════════════════════${NC}"

if [ $FAILED -ne 0 ]; then
    echo -e "${RED}❌ PRE-COMMIT FAILED - Commit blocked${NC}"
    echo ""
    echo "Next steps:"
    echo "  1. Fix issues shown above"
    echo "  2. Stage changes: ${BLUE}git add <files>${NC}"
    echo "  3. Retry commit: ${BLUE}git commit${NC}"
    echo ""
    echo "To skip hooks (NOT RECOMMENDED):"
    echo "  ${YELLOW}git commit --no-verify${NC}"
    echo ""
    exit 1
else
    echo -e "${GREEN}✅ PRE-COMMIT PASSED - Ready for commit${NC}"
    echo ""
    echo "💡 Tip: Full test suite will run on push (pre-push hook)"
    echo ""
    exit 0
fi
