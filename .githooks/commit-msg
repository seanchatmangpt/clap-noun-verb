#!/bin/bash
# Commit-msg hook: Validate commit message format
# Purpose: Enforce consistent, informative commit messages
# Exit: Non-zero to reject commit, zero to allow
#
# Accepted formats:
# - Conventional commits: type(scope): description (e.g., fix(router): handle nil pointers)
# - Simple messages: capitalized description (e.g., Fix routing table deadlock)
# - Longer format: Single-line summary, blank line, then detailed explanation

set -e

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-message}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo ""
echo "${BLUE}════════════════════════════════════════════════════════════════${NC}"
echo "${BLUE}  💬 COMMIT-MSG HOOK: Message Validation${NC}"
echo "${BLUE}════════════════════════════════════════════════════════════════${NC}"

# Read the commit message
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Trim leading/trailing whitespace
COMMIT_MSG=$(echo "$COMMIT_MSG" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

# Get just the first line
FIRST_LINE=$(echo "$COMMIT_MSG" | head -n 1)

# Skip validation for merge commits, reverts, and commits from templates
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ]; then
    echo -e "${YELLOW}⚠️  Skipping validation for merge commit${NC}"
    exit 0
fi

if echo "$FIRST_LINE" | grep -q "^Merge\|^Revert"; then
    echo -e "${YELLOW}⚠️  Skipping validation for merge/revert commit${NC}"
    exit 0
fi

FAILED=0

echo ""
echo "${BLUE}🔍 Validation 1: First line exists and is not empty${NC}"
if [ -z "$FIRST_LINE" ]; then
    echo -e "${RED}❌ FAILED: Commit message is empty${NC}"
    FAILED=1
else
    echo -e "${GREEN}✅ PASS: Message is not empty${NC}"
fi

echo ""
echo "${BLUE}🔍 Validation 2: First line length (max 72 characters)${NC}"
FIRST_LINE_LENGTH=${#FIRST_LINE}
if [ "$FIRST_LINE_LENGTH" -gt 72 ]; then
    echo -e "${RED}❌ FAILED: First line is $FIRST_LINE_LENGTH chars (max 72)${NC}"
    echo "   Current: $FIRST_LINE"
    FAILED=1
else
    echo -e "${GREEN}✅ PASS: Length is $FIRST_LINE_LENGTH chars${NC}"
fi

echo ""
echo "${BLUE}🔍 Validation 3: First line capitalization${NC}"
if ! echo "$FIRST_LINE" | grep -q '^[A-Z]'; then
    echo -e "${RED}❌ FAILED: First character must be capitalized${NC}"
    echo "   Current: $FIRST_LINE"
    FAILED=1
else
    echo -e "${GREEN}✅ PASS: First character is capitalized${NC}"
fi

echo ""
echo "${BLUE}🔍 Validation 4: No trailing period on first line${NC}"
if echo "$FIRST_LINE" | grep -q '\.$'; then
    echo -e "${YELLOW}⚠️  WARNING: First line should not end with period${NC}"
    echo "   Consider: ${FIRST_LINE%?}"
else
    echo -e "${GREEN}✅ PASS: No trailing period${NC}"
fi

echo ""
echo "${BLUE}🔍 Validation 5: Conventional commit format (optional)${NC}"
# Check if message follows conventional commits format: type(scope): message
if echo "$FIRST_LINE" | grep -qE '^(feat|fix|refactor|perf|docs|test|chore|ci|style|revert)(\(.+\))?: .+'; then
    echo -e "${GREEN}✅ PASS: Valid conventional commit${NC}"
else
    # Allow non-conventional format but note it
    echo -e "${YELLOW}ℹ️  INFO: Not conventional commit format${NC}"
    echo "   Recommended format: type(scope): description"
    echo "   Types: feat, fix, refactor, perf, docs, test, chore, ci, style"
fi

# Check for issue references or PR mentions
echo ""
echo "${BLUE}🔍 Validation 6: Issue/PR references (best practice)${NC}"
if echo "$COMMIT_MSG" | grep -qE '#[0-9]+|Fixes #|Closes #|Resolves #|Related to #'; then
    echo -e "${GREEN}✅ PASS: Contains issue/PR reference${NC}"
else
    echo -e "${YELLOW}ℹ️  INFO: No issue/PR reference found${NC}"
    echo "   Consider adding: Fixes #123 or Related to #456"
fi

# Summary
echo ""
echo "${BLUE}════════════════════════════════════════════════════════════════${NC}"

if [ $FAILED -ne 0 ]; then
    echo -e "${RED}❌ COMMIT-MSG VALIDATION FAILED${NC}"
    echo ""
    echo "Message guidelines:"
    echo "  ✓ First line: Capitalized, ≤72 chars, no period"
    echo "  ✓ Format: 'type(scope): description' (recommended)"
    echo "  ✓ Example: 'Fix router race condition when shutting down'"
    echo "  ✓ Longer: Add blank line + detailed explanation"
    echo "  ✓ References: Mention related issues (#123)"
    echo ""
    echo "Edit the message:"
    echo "  ${BLUE}git commit --amend${NC}"
    echo ""
    exit 1
else
    echo -e "${GREEN}✅ COMMIT-MSG VALIDATION PASSED${NC}"
    echo ""
    exit 0
fi
