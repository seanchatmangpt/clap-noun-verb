{
  "env": {
    "RUST_BACKTRACE": "1",
    "RUST_LOG": "debug",
    "RUSTFLAGS": "-D warnings",
    "CARGO_INCREMENTAL": "1"
  },
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(cargo-make *)",
      "Bash(git *)",
      "Bash(bash scripts/*)",
      "Bash(kubectl get *)",
      "mcp__plugin_lumen_lumen__semantic_search",
      "mcp__oclnr__audit"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git *--no-verify*)",
      "Bash(git reset --hard*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset*)"
    ]
  }
}
