/// Supported noun commands in cargo-cicd
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
pub enum NounKind {
    {% for noun in nouns -%}
    /// {{ noun.description }}
    #[serde(rename = "{{ noun.name }}")]
    {{ noun.name | title | replace("-", "") }},
    {% endfor %}
}

impl std::fmt::Display for NounKind {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        let name = match self {
            {% for noun in nouns -%}
            NounKind::{{ noun.name | title | replace("-", "") }} => "{{ noun.name }}",
            {% endfor %}
        };
        write!(f, "{}", name)
    }
}

impl std::str::FromStr for NounKind {
    type Err = String;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            {% for noun in nouns -%}
            "{{ noun.name }}" => Ok(NounKind::{{ noun.name | title | replace("-", "") }}),
            {% endfor %}
            _ => Err(format!("Unknown noun: {}", s)),
        }
    }
}

