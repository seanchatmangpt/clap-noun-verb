// ============================================================================
// ARGUMENT VALUE TYPES
// ============================================================================

/// String-based argument wrapper for type-safe handling
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct StringArg(pub String);

impl std::str::FromStr for StringArg {
    type Err = String;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        Ok(StringArg(s.to_string()))
    }
}

/// Path argument with validation
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct PathArg(pub PathBuf);

impl std::str::FromStr for PathArg {
    type Err = String;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        Ok(PathArg(PathBuf::from(s)))
    }
}

/// Numeric argument with range validation
#[derive(Debug, Clone, Copy, Serialize, Deserialize)]
pub struct NumericArg(pub u32);

impl std::str::FromStr for NumericArg {
    type Err = String;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        s.parse::<u32>()
            .map(NumericArg)
            .map_err(|e| e.to_string())
    }
}

