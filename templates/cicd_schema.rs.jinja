    type Output;

    fn convert(input: Self::Input) -> Result<Self::Output, String>;
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_noun_kinds_all_defined() {
        // Ensure all nouns from ontology are represented
        let _noun = NounKind::{% for noun in nouns | first %}{{ noun.name | title | replace("-", "") }}{% endfor %};
        assert!(true);
    }

    #[test]
    fn test_verb_kinds_all_defined() {
        // Ensure all verbs from ontology are represented
        let _verb = VerbKind::{% for noun in nouns | first %}{% for verb in noun.verbs | first %}{{ noun.name | title | replace("-", "") }}{{ verb.name | title | replace("-", "") }}{% endfor %}{% endfor %};
        assert!(true);
    }

    #[test]
    fn test_command_result_serialization() {
        let result: CommandResult<String> = CommandResult::ok("Test", "data".to_string());
        let json = serde_json::to_string(&result).unwrap();
        assert!(json.contains("success"));
    }
}
