/// # With options
/// app {{ noun_name }} {{ verb_name }} "my-resource" --tags prod --format yaml
///
/// # Preview without executing
/// app {{ noun_name }} {{ verb_name }} "my-resource" --dry-run
/// ```
///
/// # Exit Codes
///
/// * 0 - Success
/// * 1 - Validation error (invalid input)
/// * 2 - Execution error (I/O, external service)
/// * 3 - Configuration error (missing files, permissions)
#[verb("{{ noun_name }}", "{{ verb_name }}")]
pub fn {{ verb_handler_name }}(
    /// PLACEHOLDER: Primary input name
    #[arg(index = 1)]
    name: Option<String>,

