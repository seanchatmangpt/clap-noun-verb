        NounVerbError::validation_error(
            "name".to_string(),
            "<missing>".to_string(),
            Some("Name is required. Usage: app {{ noun_name }} {{ verb_name }} <name>"),
        )
    })?;

    if name.is_empty() {
        return Err(NounVerbError::validation_error(
            "name".to_string(),
            name.clone(),
            Some("Name cannot be empty"),
        ));
    }

    // Parse format option
    let _format = format
        .as_deref()
        .and_then(|s| OutputFormat::from_str(s).ok())
        .unwrap_or(OutputFormat::JsonPretty);

    // Parse tags
    let _tags = tags.unwrap_or_default();

