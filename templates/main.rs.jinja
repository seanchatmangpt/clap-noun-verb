#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_exit_code_for_validation_error() {
        // Arrange
        let error = {{ crate_lib }}::error::NounVerbError::validation_error(
            "test_field".to_string(),
            "invalid".to_string(),
            None,
        );

        // Act
        let (exit_code, _) = format_error_with_code(&error);

        // Assert
        assert_eq!(exit_code, 1, "Validation errors should exit with code 1");
    }

    #[test]
    fn test_exit_code_for_execution_error() {
        // Arrange
        let error = {{ crate_lib }}::error::NounVerbError::execution_error("test error");

        // Act
        let (exit_code, _) = format_error_with_code(&error);

        // Assert
        assert_eq!(exit_code, 2, "Execution errors should exit with code 2");
    }

    #[test]
    fn test_exit_code_for_configuration_error() {
        // Arrange
        let error = {{ crate_lib }}::error::NounVerbError::configuration_error("test config error");

        // Act
        let (exit_code, _) = format_error_with_code(&error);

        // Assert
        assert_eq!(exit_code, 3, "Configuration errors should exit with code 3");
    }

