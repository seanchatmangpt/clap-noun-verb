// ERROR FORMATTING & EXIT CODES
// ============================================================================

/// Format error message with appropriate exit code
///
/// Maps `NounVerbError` variants to exit codes and user-friendly messages.
///
/// # Arguments
///
/// * `error` - The `NounVerbError` to format
///
/// # Returns
///
/// A tuple of (exit_code, formatted_message)
fn format_error_with_code(error: &{{ crate_lib }}::error::NounVerbError) -> (i32, String) {
    use {{ crate_lib }}::error::NounVerbError;

    match error {
        // Validation errors (exit code 1)
        NounVerbError::ValidationError { field, value, hint } => (
            1,
            format!(
                "Validation Error: Field '{}' has invalid value '{}'\n{}",
                field,
                value,
                hint.as_deref().unwrap_or("Check your input and try again.")
            ),
        ),

        // Execution errors (exit code 2)
        NounVerbError::ExecutionError(msg) => (
            2,
            format!("Execution Error: {}\n\nTroubleshooting:\n- Check network connectivity\n- Verify external service availability\n- Review logs for details", msg),
        ),

        // Configuration errors (exit code 3)
        NounVerbError::ConfigurationError { reason } => (
            3,
            format!(
                "Configuration Error: {}\n\nTroubleshooting:\n- Check configuration file permissions\n- Verify required environment variables are set\n- See documentation for setup instructions",
                reason
            ),
        ),

        // All other errors (exit code 2)
        _ => (2, format!("Error: {}", error)),
    }
}

