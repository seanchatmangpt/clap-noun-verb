# The exact ontology `~/ggen-marketplace/packs/clap-noun-verb-zeroconfig-pack`
# ships and compiles into a real generated Rust CLI (via clap-noun-verb-crate-pack
# and its sibling packs). Copied here verbatim, projected a SECOND way -- through
# cnv-any-manifest-pack instead of the Rust-generating packs -- to prove cnv-any's
# manifest path works identically for an ontology that ALSO compiles to native
# Rust, not just for genuinely foreign targets. See README.md.
@prefix cnv: <https://clap-noun-verb.dev/ontology#> .

cnv:ZeroConfigCli
    a cnv:Cli ;
    cnv:binaryName "zc" ;
    cnv:crateName "zero-config-cli" ;
    cnv:version "0.1.0" ;
    cnv:edition "2024" ;
    cnv:rustVersion "1.85" ;
    cnv:about "Zero-config clap-noun-verb starter: rename me, then add nouns and commands." ;
    cnv:hasNoun cnv:GreetNoun, cnv:SystemNoun .

# ── Nouns ────────────────────────────────────────────────────────────────────

cnv:GreetNoun
    a cnv:Noun ;
    cnv:name "greet" ;
    cnv:about "Say hello and do simple typed arithmetic." ;
    cnv:hasCommand cnv:GreetHello, cnv:GreetAdd .

cnv:SystemNoun
    a cnv:Noun ;
    cnv:name "system" ;
    cnv:about "Inspect the generated CLI and exercise explicit refusal." ;
    cnv:hasCommand cnv:SystemPing, cnv:SystemRefuse .

# ── greet hello (echo behavior) ──────────────────────────────────────────────

cnv:GreetHello
    a cnv:Command ;
    cnv:name "hello" ;
    cnv:about "Return typed command inputs as a JSON object." ;
    cnv:belongsToNoun cnv:GreetNoun ;
    cnv:hasArgument cnv:HelloName, cnv:HelloUppercase ;
    cnv:hasBehavior cnv:GreetHelloBehavior .

cnv:HelloName
    a cnv:Argument ;
    cnv:name "name" ;
    cnv:fieldName "name" ;
    cnv:valueKind "string" ;
    cnv:required true ;
    cnv:position 1 ;
    cnv:testValue "World" ;
    cnv:about "Who to greet." .

cnv:HelloUppercase
    a cnv:Argument ;
    cnv:name "uppercase" ;
    cnv:fieldName "uppercase" ;
    cnv:valueKind "bool" ;
    cnv:required false ;
    cnv:position 0 ;
    cnv:testValue "true" ;
    cnv:longFlag "uppercase" ;
    cnv:shortFlag "u" ;
    cnv:about "Include an uppercase-request flag in the returned input object." .

cnv:GreetHelloBehavior a cnv:EchoBehavior .

# ── greet add (expression behavior) ──────────────────────────────────────────

cnv:GreetAdd
    a cnv:Command ;
    cnv:name "add" ;
    cnv:about "Add two signed 64-bit integers through the generated expression interpreter." ;
    cnv:belongsToNoun cnv:GreetNoun ;
    cnv:hasArgument cnv:AddLeft, cnv:AddRight ;
    cnv:hasBehavior cnv:AddBehavior .

cnv:AddLeft
    a cnv:Argument ;
    cnv:name "left" ;
    cnv:fieldName "left" ;
    cnv:valueKind "i64" ;
    cnv:required true ;
    cnv:position 1 ;
    cnv:testValue "2" ;
    cnv:about "Left operand." .

cnv:AddRight
    a cnv:Argument ;
    cnv:name "right" ;
    cnv:fieldName "right" ;
    cnv:valueKind "i64" ;
    cnv:required true ;
    cnv:position 2 ;
    cnv:testValue "3" ;
    cnv:about "Right operand." .

cnv:AddBehavior
    a cnv:ExpressionBehavior ;
    cnv:operator "add" ;
    cnv:leftArgument "left" ;
    cnv:rightArgument "right" .

# ── system ping (static JSON behavior) ───────────────────────────────────────

cnv:SystemPing
    a cnv:Command ;
    cnv:name "ping" ;
    cnv:about "Return a deterministic ontology-owned liveness value." ;
    cnv:belongsToNoun cnv:SystemNoun ;
    cnv:hasBehavior cnv:PingBehavior .

cnv:PingBehavior
    a cnv:StaticJsonBehavior ;
    cnv:jsonValue "{\"status\":\"alive\",\"source\":\"clap-noun-verb-zeroconfig-pack\"}" .

# ── system refuse (explicit refusal behavior) ────────────────────────────────

cnv:SystemRefuse
    a cnv:Command ;
    cnv:name "refuse" ;
    cnv:about "Exercise a typed ontology-declared refusal path." ;
    cnv:belongsToNoun cnv:SystemNoun ;
    cnv:hasBehavior cnv:ExplicitRefusal .

cnv:ExplicitRefusal
    a cnv:RefusalBehavior ;
    cnv:refusalCode "DEMONSTRATION_REFUSAL" ;
    cnv:refusalMessage "This command is intentionally refused by the admitted graph." .
