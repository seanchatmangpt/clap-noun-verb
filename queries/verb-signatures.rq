# verb-signatures.rq
# One row per verb. Projects exactly the columns the thin verb.rs.tera consumes.
#
# `args` is a deterministic, lexically sortable GROUP_CONCAT of per-argument
# projection records. Each record has ten "|" delimited fields:
#
#   sort_key | field | rust_type | required | about | cli_position |
#   argument_type | short_name | default_value | cli_name
#
# The external projection-delimiter gate refuses "|" and "@@" in projected
# literals before this query crosses the template boundary.
#
# Sanitizer note: kebab->snake is selected here; Rust-keyword raw-identifier
# escaping is terminal projection in the template. Field collision and argument
# semantic validity are enforced by external ASK gates.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX cnv: <http://clap-noun-verb.io/ontology#>

SELECT
  ?noun_name
  ?verb_name
  ?verb_about
  ?return_type
  ?handler_name
  (GROUP_CONCAT(?argSpec ; separator="@@") AS ?args)
WHERE {
  ?verb a cnv:Verb ;
        cnv:hasVerbName ?verb_name .

  OPTIONAL {
    ?verb cnv:belongsToNoun ?noun .
    ?noun cnv:hasNounName ?nounNameRaw .
  }
  BIND(COALESCE(?nounNameRaw, "") AS ?noun_name)

  OPTIONAL { ?verb cnv:verbAbout ?verbAboutRaw . }
  BIND(COALESCE(?verbAboutRaw, "") AS ?verb_about)

  OPTIONAL { ?verb cnv:returnType ?returnTypeRaw . }
  BIND(COALESCE(?returnTypeRaw, "()") AS ?return_type)

  BIND(REPLACE(?verb_name, "-", "_") AS ?handler_name)

  OPTIONAL {
    ?verb cnv:hasArguments ?arg .
    ?arg cnv:hasArgumentName ?cliNameRaw .

    OPTIONAL { ?arg cnv:fieldName ?explicitField . }
    BIND(REPLACE(?cliNameRaw, "-", "_") AS ?snakeField)
    BIND(COALESCE(?explicitField, ?snakeField) AS ?field)
    BIND(STR(?cliNameRaw) AS ?cli_name)

    OPTIONAL { ?arg cnv:valueType ?valueTypeRaw . }
    BIND(COALESCE(?valueTypeRaw, "String") AS ?rust_type)

    OPTIONAL { ?arg cnv:argumentType ?argumentTypeRaw . }
    BIND(
      IF(
        !BOUND(?argumentTypeRaw),
        "",
        IF(?argumentTypeRaw = cnv:ArgumentType_Required, "required",
          IF(?argumentTypeRaw = cnv:ArgumentType_Optional, "optional",
            IF(?argumentTypeRaw = cnv:ArgumentType_Flag, "flag",
              IF(?argumentTypeRaw = cnv:ArgumentType_Repeating, "repeating", "")
            )
          )
        )
      )
      AS ?argument_type
    )

    OPTIONAL { ?arg cnv:required ?requiredRaw . }
    BIND(
      IF(
        BOUND(?requiredRaw),
        STR(?requiredRaw),
        IF(?argumentTypeRaw = cnv:ArgumentType_Required, "true", "false")
      )
      AS ?required
    )

    OPTIONAL { ?arg cnv:argumentAbout ?argAboutRaw . }
    BIND(COALESCE(?argAboutRaw, "") AS ?about)

    OPTIONAL { ?arg cnv:cliPosition ?positionRaw . }
    BIND(IF(BOUND(?positionRaw), STR(?positionRaw), "") AS ?cli_position)

    OPTIONAL { ?arg cnv:shortName ?shortNameRaw . }
    BIND(IF(BOUND(?shortNameRaw), STR(?shortNameRaw), "") AS ?short_name)

    OPTIONAL { ?arg cnv:defaultValue ?defaultValueRaw . }
    BIND(IF(BOUND(?defaultValueRaw), STR(?defaultValueRaw), "") AS ?default_value)

    # Make aggregate order irrelevant: Tera sorts records by this first field.
    # Positional arguments sort first by a zero-padded 1-based position; all
    # named/flag arguments then sort lexically by their projected Rust field.
    BIND(
      IF(
        BOUND(?positionRaw),
        CONCAT(
          "0:",
          IF(?positionRaw < 10, "000",
            IF(?positionRaw < 100, "00",
              IF(?positionRaw < 1000, "0", "")
            )
          ),
          STR(?positionRaw)
        ),
        CONCAT("1:", ?field)
      )
      AS ?sort_key
    )

    BIND(
      CONCAT(
        ?sort_key, "|", ?field, "|", ?rust_type, "|", ?required, "|",
        ?about, "|", ?cli_position, "|", ?argument_type, "|",
        ?short_name, "|", ?default_value, "|", ?cli_name
      )
      AS ?argSpec
    )
  }
}
GROUP BY ?noun_name ?verb_name ?verb_about ?return_type ?handler_name
ORDER BY ?noun_name ?verb_name
